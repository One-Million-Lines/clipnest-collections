# Copy these values into backend/.env before running the API service.
VT_ENV=development
APP_HOST=0.0.0.0
APP_PORT=5201

# Optional provider credentials referenced by backend/vtlib/generative_llm.py
OPENAI_APIKEY=
GOOGLE_GENAI_APIKEY=
ANTHROPIC_API_KEY=
VERTEXAI_APIKEY=

# Optional JSON config value parsed by vtutils.confparser.env_config().
# Example:
# json_GOOGLE_SA={"json_file":"path/to/service-account.json"}
json_GOOGLE_SA=
